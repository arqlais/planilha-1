rules_version = '2';

// Planilha de Treino
// - Administrador (professor): acesso total. E-mail igual ao de config.js.
// - Aluno: lê o próprio perfil (treinos, divisão, recados) e lê/grava as próprias marcações.
// - Convite: o aluno liga a conta dele a um perfil informando o código de convite daquele perfil.
// - Pedido de acesso: quem cria conta sem código manda um pedido; o professor aceita no app.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'igorpedrodeoliveira15@gmail.com';
    }
    function isOwner(pid) {
      return request.auth != null
        && get(/databases/$(database)/documents/profiles/$(pid)).data.uid == request.auth.uid;
    }

    // Pedido de acesso: quem criou conta sem código pede para ser aluno; só o professor aceita
    match /requests/{uid} {
      allow read, delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.uid == uid;
    }

    // Visitantes: o app registra que alguém abriu (mesmo sem login). Só o professor lê.
    // Sem login dá para gravar, mas só no formato do app: campos curtos, contador sobe de 1 em 1,
    // um dia novo por vez, e ninguém se passa por aluno ou professor (uid/e-mail/admin só da própria conta).
    function visitShape(d) {
      return d.keys().hasOnly(['first', 'last', 'days', 'n', 'dev', 'src', 'uid', 'email', 'admin'])
        && (!('days' in d) || (d.days is list && d.days.size() <= 400))
        && (!('n' in d) || (d.n is int && d.n >= 0))
        && (!('first' in d) || (d.first is string && d.first.size() <= 30))
        && (!('last' in d) || (d.last is string && d.last.size() <= 30))
        && (!('dev' in d) || (d.dev is string && d.dev.size() <= 20))
        && (!('src' in d) || (d.src is string && d.src.size() <= 40))
        && (!('email' in d) || (d.email is string && d.email.size() <= 80))
        && (!('admin' in d) || d.admin == true);
    }
    function visitWho(d, changed) {
      return (!('uid' in changed) || (request.auth != null && d.uid == request.auth.uid))
        && (!('email' in changed) || (request.auth != null
              && (d.email == '' || d.email.lower() == request.auth.token.get('email', '').lower())))
        && (!('admin' in changed) || isAdmin());
    }
    match /visits/{vid} {
      allow read, delete: if isAdmin();
      allow create: if vid.matches('[a-z0-9]{12,40}')
        && visitShape(request.resource.data)
        && visitWho(request.resource.data, request.resource.data.keys())
        && request.resource.data.get('n', 0) <= 1
        && request.resource.data.get('days', []).size() <= 1;
      allow update: if visitShape(request.resource.data)
        && visitWho(request.resource.data, request.resource.data.diff(resource.data).affectedKeys())
        && request.resource.data.get('n', 0) <= resource.data.get('n', 0) + 1
        && request.resource.data.get('days', []).size() <= resource.data.get('days', []).size() + 1;
    }

    // Cópias automáticas diárias (só o professor)
    match /backups/{id} {
      allow read, write: if isAdmin();
    }

    match /profiles/{pid} {
      // Ninguém apaga aluno na nuvem (nem por erro do app): "Excluir" manda para a lixeira
      allow read, create, update: if isAdmin();
      allow delete: if false;

      // Aluno lê só o próprio perfil (inclusive a busca "where uid == meu uid")
      allow get, list: if request.auth != null && resource.data.uid == request.auth.uid;

      // Aluno usa o convite: só pode preencher o próprio uid num perfil ainda sem dono,
      // e só se informar o código de convite certo
      allow update: if request.auth != null
        && resource.data.uid == null
        && resource.data.inviteCode is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'claim'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.claim == resource.data.inviteCode;

      // Marcações (séries e cardio), um documento por mês
      match /months/{month} {
        allow read, create, update: if isAdmin() || isOwner(pid);
        allow delete: if false;
      }
    }
  }
}
